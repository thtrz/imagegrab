{
  "manifest_version": 3,
  "name": "图提取 · ImageGrab",
  "description": "在商品详情页提取图片、集中预览，并将勾选的图片真正转换为 PNG 后下载。",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "*://*.taobao.com/*",
    "*://*.tmall.com/*",
    "*://*.jd.com/*",
    "*://*.pinduoduo.com/*",
    "*://*.yangkeduo.com/*",
    "*://*.alicdn.com/*",
    "*://*.360buyimg.com/*",
    "*://*.jdimg.com/*",
    "*://*.pddpic.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "图提取：扫描当前商品页面"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.jd.com/*",
        "*://*.pinduoduo.com/*",
        "*://*.yangkeduo.com/*"
      ],
      "js": [
        "lib/core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
